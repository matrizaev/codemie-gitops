{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemie.epam.com/schemas/gitops/outcome-v1.json",
  "title": "codemie-gitops successful per-entity outcome",
  "description": "Version: v25 (SEC-005 remediation — identifier fields constrained against control and bidi characters).",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "kind", "project"],
  "properties": {
    "action": {"enum": ["valid", "created", "updated"]},
    "kind": {"enum": ["Assistant", "Workflow", "Datasource", "Skill"]},
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "repo_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "Assistant"}}, "required": ["kind"]},
      "then": {"required": ["slug"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["repo_name"]}]}}
    },
    {
      "if": {"properties": {"kind": {"const": "Workflow"}}, "required": ["kind"]},
      "then": {"required": ["slug"], "not": {"anyOf": [{"required": ["name"]}, {"required": ["repo_name"]}]}}
    },
    {
      "if": {"properties": {"kind": {"const": "Skill"}}, "required": ["kind"]},
      "then": {"required": ["name"], "not": {"anyOf": [{"required": ["slug"]}, {"required": ["repo_name"]}]}}
    },
    {
      "if": {"properties": {"kind": {"const": "Datasource"}}, "required": ["kind"]},
      "then": {"required": ["repo_name"], "not": {"anyOf": [{"required": ["slug"]}, {"required": ["name"]}]}}
    }
  ]
}
