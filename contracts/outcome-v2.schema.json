{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemie.epam.com/schemas/gitops/outcome-v2.json",
  "title": "codemie-gitops successful per-entity outcome v2",
  "description": "Closed v2 superset of outcome-v1 adding save success and Workflow adoptionRequired.",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "kind", "project"],
  "properties": {
    "action": {"enum": ["valid", "created", "updated", "saved"]},
    "kind": {"enum": ["Assistant", "Workflow", "Datasource", "Skill"]},
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "repo_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\u0080-\\u009f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "adoptionRequired": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "Assistant"}}, "required": ["kind"]},
      "then": {
        "required": ["slug"],
        "not": {"anyOf": [{"required": ["name"]}, {"required": ["repo_name"]}]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "Workflow"}}, "required": ["kind"]},
      "then": {
        "required": ["slug"],
        "not": {"anyOf": [{"required": ["name"]}, {"required": ["repo_name"]}]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "Skill"}}, "required": ["kind"]},
      "then": {
        "required": ["name"],
        "not": {"anyOf": [{"required": ["slug"]}, {"required": ["repo_name"]}]}
      }
    },
    {
      "if": {"properties": {"kind": {"const": "Datasource"}}, "required": ["kind"]},
      "then": {
        "required": ["repo_name"],
        "not": {"anyOf": [{"required": ["slug"]}, {"required": ["name"]}]}
      }
    },
    {
      "if": {"required": ["adoptionRequired"]},
      "then": {
        "properties": {
          "action": {"const": "saved"},
          "kind": {"const": "Workflow"},
          "adoptionRequired": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {"action": {"enum": ["valid", "created", "updated"]}},
        "required": ["action"]
      },
      "then": {"not": {"required": ["adoptionRequired"]}}
    }
  ]
}
