{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codemie.epam.com/schemas/gitops/save-read-reverse-manifest-v1.json",
  "title": "codemie-gitops save read and reverse-projection manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "declarationApiVersion",
    "source",
    "compatibilityPolicy",
    "sharedComponentRules",
    "entities"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "manifestVersion": {"const": 1},
    "declarationApiVersion": {"const": "codemie.epam.com/v1alpha1"},
    "source": {"$ref": "#/$defs/source"},
    "compatibilityPolicy": {"$ref": "#/$defs/compatibility"},
    "sharedComponentRules": {
      "type": "array",
      "items": {"$ref": "#/$defs/componentRule"}
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Assistant", "Workflow", "Skill", "Datasource"],
      "properties": {
        "Assistant": {"$ref": "#/$defs/entity"},
        "Workflow": {"$ref": "#/$defs/entity"},
        "Skill": {"$ref": "#/$defs/entity"},
        "Datasource": {"$ref": "#/$defs/entity"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backendTag", "backendCommit", "evidenceOnly"],
      "properties": {
        "backendTag": {"const": "2.42.0"},
        "backendCommit": {"const": "2a481c290c99bf30ef80aadafa03d876a7f5f732"},
        "evidenceOnly": {"const": true},
        "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infoVersionIsIdentity",
        "unknownContractedField",
        "missingOrInvalidField",
        "unclassifiedAuthoringState",
        "rawBodyRetention"
      ],
      "properties": {
        "infoVersionIsIdentity": {"const": false},
        "unknownContractedField": {"const": "E_API_INCOMPATIBLE"},
        "missingOrInvalidField": {"const": "E_API_INCOMPATIBLE"},
        "unclassifiedAuthoringState": {"const": "E_API_INCOMPATIBLE"},
        "rawBodyRetention": {"const": "forbidden"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "method", "template", "purpose", "responseRoot", "unknownFieldPolicy"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "method": {"const": "GET"},
        "template": {"type": "string", "pattern": "^/v1/"},
        "purpose": {"type": "string", "minLength": 1},
        "responseRoot": {"type": "string", "minLength": 1},
        "unknownFieldPolicy": {"enum": ["reject", "classified-additive-only"]},
        "pagination": {"$ref": "#/$defs/pagination"},
        "snapshot": {"type": "string", "minLength": 1}
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageBase", "perPage", "pageFields", "invariants", "instability"],
      "properties": {
        "pageBase": {"const": 0},
        "perPage": {"const": 100},
        "pageFields": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "instability": {"const": "E_RESOLUTION_UNSTABLE"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["naturalKey", "completeVisibility", "rules"],
      "properties": {
        "naturalKey": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
        "completeVisibility": {"type": "boolean"},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "fieldRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "class"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "class": {
          "enum": [
            "direct-authorable",
            "bounded-transform",
            "managed-reference",
            "mixed-owned",
            "safe-excluded",
            "secret-or-masked",
            "required-non-exportable"
          ]
        },
        "target": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "ordering": {"type": "string", "minLength": 1}
      }
    },
    "referenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePath", "targetKind", "target", "reads", "failure"],
      "properties": {
        "sourcePath": {"type": "string", "minLength": 1},
        "targetKind": {"enum": ["Assistant", "Skill", "Datasource"]},
        "target": {"type": "string", "minLength": 1},
        "reads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure": {"type": "string", "minLength": 1}
      }
    },
    "exportability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "incompatible", "nonExportable"],
      "properties": {
        "supported": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "incompatible": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "nonExportable": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "componentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "schemaRef", "fieldRules"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "schemaRef": {"type": "string", "minLength": 1},
        "fieldRules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldRule"}}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selection", "routes", "fieldRules", "referenceRules", "exportability"],
      "properties": {
        "selection": {"$ref": "#/$defs/selection"},
        "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
        "fieldRules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fieldRule"}},
        "referenceRules": {"type": "array", "items": {"$ref": "#/$defs/referenceRule"}},
        "exportability": {"$ref": "#/$defs/exportability"},
        "discriminatorRules": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
