{
  "schemaVersion": 1,
  "canonicalEnvironmentPattern": "^[a-z0-9][a-z0-9-]{0,62}$",
  "ownerRoles": {
    "serialization": "Release Engineering",
    "identityWriterGovernance": "CodeMie Platform Administrator",
    "identityInventory": "CodeMie Platform Identity Administrator",
    "remediation": "CodeMie Platform Operations Incident Commander"
  },
  "serialization": {
    "scope": "target-environment",
    "githubConcurrencyPrefix": "codemie-gitops-apply-",
    "githubQueue": "max",
    "gitlabResourceGroupPrefix": "codemie-gitops-apply-",
    "gitlabProductionEnvironment": "production",
    "gitlabIndependentDrillEnvironment": "staging",
    "remoteProtectedEnvironmentRequired": true
  },
  "artifactPromotion": {
    "target": "x86_64-unknown-linux-musl",
    "gitlabBuildRunnerTag": "codemie-gitops-musl-build",
    "buildAndTestWithoutProductionEnvironment": true,
    "applyConsumesBuildArtifact": true,
    "sha256VerificationBeforeExecution": true,
    "rebuildInProtectedApplyJob": false
  },
  "identityWriterGovernance": {
    "entities": [
      "Workflow",
      "Skill",
      "Datasource"
    ],
    "deploymentWindowWriter": "serialized CodeMie GitOps CI principal",
    "emergencyWriterRole": "CodeMie Platform Administrator",
    "freezeExternalWritersDuringDeployment": true,
    "governedOperations": [
      "Workflow create, adoption, project/slug identity change, or reserved marker change",
      "Skill create or project/name identity change",
      "Datasource create or project/repo_name identity change"
    ]
  },
  "inventory": {
    "completeVisibilityRequired": true,
    "beforeEveryDeploymentWindow": true,
    "afterConcurrentWriterEvent": true,
    "afterUncertainWrite": true,
    "gates": {
      "invalidWorkflowMarkers": 0,
      "duplicateWorkflowNaturalKeys": 0,
      "invalidSkillRecords": 0,
      "duplicateSkillNaturalKeys": 0,
      "invalidDatasourceRecords": 0,
      "duplicateDatasourceNaturalKeys": 0
    }
  },
  "remediation": {
    "automaticRetry": false,
    "automaticDelete": false,
    "automaticRollback": false,
    "automaticTieBreak": false,
    "resumeRequiresCleanInventory": true
  }
}
